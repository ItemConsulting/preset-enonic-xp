{
  "name": "@itemconsulting/preset-enonic-xp",
  "version": "0.4.0",
  "description": "Preset for using Storybook with Enonic XP",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc -p .",
    "lint": "eslint --cache --fix 'src/**/*.ts'",
