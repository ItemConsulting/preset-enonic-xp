  "license": "MIT",
  "dependencies": {
    "loader-utils": "^3.3.1"
  },
  "engines": {
    "node": ">=20.11.0 || >= 21.2.0 || >=22"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@types/node": "^25.0.1",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "prettier": "^3.7.4",
    "storybook": "^10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.49.0",
    "webpack": "^5.103.0"
  }
